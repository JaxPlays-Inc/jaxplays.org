{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaxplays-hugo-archive",
  "main": "src/worker.js",
  "account_id": "7702aab49d9cdff6c238c0c5021d5ef4",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../sites/jaxplays/public-archive",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "LARGE_ASSETS",
      "bucket_name": "jaxplays-hugo-archive-large-assets"
    }
  ],
  "routes": [
    {
      "pattern": "hugo.jaxplays.org",
      "custom_domain": true
    }
  ]
}
